    <!-- JAVASCRIPT INTERACTIVITY -->
    <script>
        // 1. Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        // 2. Hero Interactive Shelf-Life Simulator
        let currentSimCommodity = 'mangga';

        const simConfig = {
            mangga: { name: 'Mangga Harum Manis', ctrlDecayRate: 5.5, treatDecayRate: 1.6, emoji: '🥭' },
            tomat:  { name: 'Tomat Segar',        ctrlDecayRate: 6.2, treatDecayRate: 1.9, emoji: '🍅' },
            cabai:  { name: 'Cabai Merah Keriting', ctrlDecayRate: 6.5, treatDecayRate: 2.0, emoji: '🌶️' }
        };

        function setSimCommodity(type) {
            currentSimCommodity = type;
            document.querySelectorAll('.sim-tab').forEach(btn => {
                btn.classList.remove('bg-forest', 'text-white');
                btn.classList.add('text-gray-600');
            });
            const activeBtn = document.getElementById(`sim-btn-${type}`);
            activeBtn.classList.add('bg-forest', 'text-white');
            activeBtn.classList.remove('text-gray-600');
            updateSimulation();
        }

        function updateSimulation() {
            const day = parseInt(document.getElementById('day-slider').value);
            const data = simConfig[currentSimCommodity];
            document.getElementById('day-badge').textContent = `Hari ke-${day}`;

            // Calculate freshness & weight loss
            const ctrlFreshness = Math.max(12, Math.round(100 - (day - 1) * data.ctrlDecayRate));
            const treatFreshness = Math.max(76, Math.round(100 - (day - 1) * data.treatDecayRate));

            const ctrlWeightLoss = ((day - 1) * 1.72).toFixed(1);
            const treatWeightLoss = ((day - 1) * 0.54).toFixed(1);

            // Update metrics DOM
            document.getElementById('ctrl-freshness').textContent = `${ctrlFreshness}%`;
            document.getElementById('ctrl-freshness-bar').style.width = `${ctrlFreshness}%`;
            document.getElementById('ctrl-weightloss').textContent = `${ctrlWeightLoss}%`;

            document.getElementById('treat-freshness').textContent = `${treatFreshness}%`;
            document.getElementById('treat-freshness-bar').style.width = `${treatFreshness}%`;
            document.getElementById('treat-weightloss').textContent = `${treatWeightLoss}%`;

            // Update visual appearance & status tags
            const ctrlVisual = document.getElementById('ctrl-visual');
            const treatVisual = document.getElementById('treat-visual');
            const ctrlTag = document.getElementById('ctrl-status-tag');
            const treatTag = document.getElementById('treat-status-tag');
            const insight = document.getElementById('sim-insight');

            let ctrlFilter = '';
            let ctrlNote = 'Kondisi Awal';
            if (day <= 4) {
                ctrlTag.textContent = 'Mulai Melunak';
                ctrlFilter = 'saturate(0.9)';
                ctrlNote = 'Mulai kehilangan kelembapan';
            } else if (day <= 9) {
                ctrlTag.textContent = 'Keriput & Layu';
                ctrlFilter = 'sepia(0.45) brightness(0.85)';
                ctrlNote = 'Kulit keriput, bercak mulai muncul';
            } else {
                ctrlTag.textContent = 'Busuk / Tidak Layak Jual';
                ctrlFilter = 'sepia(0.85) brightness(0.6) contrast(1.2)';
                ctrlNote = 'Infeksi jamur & susut berat tinggi';
            }

            let treatNote = 'Terlindungi Perisai Mikro';
            if (day <= 7) {
                treatTag.textContent = 'Sangat Segar';
                treatNote = 'Tekstur keras, warna cerah alami';
            } else {
                treatTag.textContent = 'Tetap Segar & Layak Jual';
                treatNote = 'Respirasi terhambat, bebas jamur';
            }

            ctrlVisual.innerHTML = `
                <div class="relative flex items-center justify-center">
                    <span class="text-5xl transition-all duration-300" style="filter: ${ctrlFilter}; transform: scale(${1 - (day * 0.012)})">${data.emoji}</span>
                    ${day >= 7 ? `<span class="absolute -bottom-1 -right-2 text-lg" title="Bercak Pembusukan">🦠</span>` : ''}
                </div>
                <span class="text-[11px] font-medium text-gray-500 mt-2">${ctrlNote}</span>
            `;

            treatVisual.innerHTML = `
                <div class="relative flex items-center justify-center">
                    <div class="absolute w-20 h-20 rounded-full border-2 border-dashed border-limefresh animate-spin" style="animation-duration: 18s;"></div>
                    <div class="absolute w-16 h-16 rounded-full bg-softmint/50"></div>
                    <span class="text-5xl relative z-10">${data.emoji}</span>
                    <span class="absolute -top-1 -right-3 text-sm bg-forest text-white rounded-full px-1.5 py-0.5 shadow">🛡️</span>
                </div>
                <span class="text-[11px] font-semibold text-forest mt-2">${treatNote}</span>
            `;

            insight.innerHTML = `💡 <strong>Hari ke-${day} (${data.name}):</strong> Buah dengan <strong>PectiShield™</strong> mempertahankan kesegaran <strong>${treatFreshness}%</strong> (selisih +${treatFreshness - ctrlFreshness}% lebih segar dibanding kontrol tanpa pelapis).`;
        }
// ... existing code ... -->
        // 5. FAQ Accordion Logic
        function toggleFaq(index) {
            const body = document.getElementById(`faq-body-${index}`);
            const icon = document.getElementById(`faq-icon-${index}`);
            const isHidden = body.classList.contains('hidden');

            // Close all first for clean single-open accordion behavior
            document.querySelectorAll('[id^="faq-body-"]').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('[id^="faq-icon-"]').forEach(el => {
                el.textContent = '+';
                el.classList.remove('rotate-45');
            });

            if (isHidden) {
                body.classList.remove('hidden');
                icon.textContent = '−';
            }
        }

        // 6. Order / Sample Modal Logic
        const modal = document.getElementById('order-modal');
        const orderForm = document.getElementById('order-form');
        const orderSuccess = document.getElementById('order-success');

        function openOrderModal(productLabel) {
            document.getElementById('modal-product').value = productLabel;
            orderForm.classList.remove('hidden');
            orderSuccess.classList.add('hidden');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeOrderModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function submitOrderForm(e) {
            e.preventDefault();
            const product = document.getElementById('modal-product').value;
            const name = document.getElementById('modal-name').value;
            const wa = document.getElementById('modal-wa').value;
            const crop = document.getElementById('modal-crop').value;

            orderForm.classList.add('hidden');
            orderSuccess.classList.remove('hidden');
            document.getElementById('order-summary-text').innerHTML = `
                Terima kasih, <strong>${name}</strong>! Permintaan Anda untuk <strong>${product}</strong> (komoditas: <em>${crop}</em>) telah kami terima. Tim PectiShield™ akan menghubungi nomor WhatsApp <strong>${wa}</strong> dalam 1×24 jam.
            `;
        }

        // Initialize default states on page load
        window.addEventListener('DOMContentLoaded', () => {
            updateSimulation();
            calculateDosage();
        });
    </script>
